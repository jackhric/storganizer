# Copy to .env and adjust as needed. All values have sensible defaults.

# Async SQLAlchemy database URL.
DATABASE_URL=sqlite+aiosqlite:///./storganizer.db

# Directory for uploaded item images and generated thumbnails.
STORAGE_DIR=./storage

# Browser origins allowed to call the API (JSON array).
CORS_ORIGINS=["http://localhost:3000"]

# Device heartbeat cadence, in seconds.
HEARTBEAT_INTERVAL_SECONDS=60

# Per-request timeout when talking to a WLED device, in seconds.
WLED_TIMEOUT_SECONDS=3.0

# Create tables on startup if missing (dev convenience). Set false and use
# Alembic in production.
AUTO_CREATE_DB=true
